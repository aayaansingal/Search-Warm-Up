{
  "manifest_version": 3,
  "name": "Search Warm-Up",
  "version": "1.0.0",
  "description": "Runs a short warm-up sequence of harmless searches before your real Google query, reducing CAPTCHA prompts on VPNs, proxies, and incognito.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "spanning",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "g"
  },
  "action": {
    "default_title": "Search Warm-Up",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Open the Search Warm-Up search box"
    }
  },
  "options_page": "src/options.html",
